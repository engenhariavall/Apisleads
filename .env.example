# ==============================================================================
# PROJETO VERSUS / API LEADS — VARIÁVEIS DE AMBIENTE DE PRODUÇÃO
# ==============================================================================

# Porta da aplicação na VPS
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=production

# Controle de Acesso CORS (separado por vírgula, suporta wildcards *.vercel.app)
CORS_ORIGIN=https://*.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# String de Conexão com o Supabase (PostgreSQL) - Fase 24
# Ex: postgresql://postgres.xxxxxx:SuaSenha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Autenticação, RBAC & Admin Master - Fase 26
JWT_SECRET=versus_master_jwt_secret_production_key_change_me_9921
JWT_EXPIRES_IN=24h
SUPER_ADMIN_EMAIL=admin@versus.ai
SUPER_ADMIN_PASSWORD=VersusAdmin@2026!
SUPER_ADMIN_NAME=Super Admin Master

# ==============================================================================
# BUREAU DE DADOS & ENRIQUECIMENTO TELEFÔNICO PAGO (FASE 51 - ETAPA 3)
# Provedores Suportados: assertiva | unitfour | zapi | bigdatacorp
# Se BUREAU_API_KEY estiver vazia, o sistema opera em fallback aberto/scraping
# ou retorna "Telefone não localizado", sem interromper a aplicação.
# ==============================================================================
BUREAU_API_URL=
BUREAU_API_KEY=
BUREAU_PROVIDER=assertiva

# Endpoints Oficiais do SIGEF/INCRA (Malha Fundiária GeoServer WFS)
SIGEF_API_URL=https://geoserver.incra.gov.br/geoserver/wfs

# Endpoints Oficiais de Validação da Receita Federal (BrasilAPI com fallback Minha Receita)
RECEITA_API_URL=https://brasilapi.com.br/api/cnpj/v1/

# FASE 54: COPILOTO DE IA (AGENT OPENAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ==============================================================================
# FASE 56: PIPELINE DE INTEGRA��O CRM (WEBHOOK GATEWAY)
# URL do Webhook do seu CRM (RD Station, HubSpot, Pipefy, ActiveCampaign, n8n)
# Ex: https://app.rdstation.com.br/api/1.3/conversions?api_key=SUA_KEY
# Ex: https://hooks.zapier.com/hooks/catch/xxxxxx/
# Se vazio, o sistema opera em modo offline (avisa o operador sem travar).
# ==============================================================================
CRM_WEBHOOK_URL=
